        },
        "severity_parameterization": {
          "$ref": "#/$defs/nullableString"
        },
        "homogeneous_medium_assumption": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "NR"
          ]
        },
        "particle_properties_modeled": {
          "type": "string",
          "enum": [
            "yes",
