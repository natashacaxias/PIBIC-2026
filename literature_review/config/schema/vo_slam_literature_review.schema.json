          "type": "string",
          "enum": [
            "yes",
            "no",
            "NR"
          ]
        },
        "validation_details": {
          "$ref": "#/$defs/nullableString"
        },
        "image_quality_metrics": {
          "$ref": "#/$defs/stringArray"
        },
        "downstream_robotics_evaluation": {
          "$ref": "#/$defs/nullableString"
        },
        "restoration_method": {
          "$ref": "#/$defs/nullableString"
        },
        "restoration_improves_perception": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "mixed",
            "NR"
          ]
        },
        "physical_limitations": {
          "$ref": "#/$defs/stringArray"
        },
        "relevance_to_smoke_emulation": {
          "$ref": "#/$defs/nullableString"
        },
        "potential_methodological_risk": {
          "$ref": "#/$defs/stringArray"
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidenceRefArray"
        }
      }
    },
    "datasetsBenchmarks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "datasets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dataset_name",
              "environment",
              "sensor_modalities",
              "adverse_conditions"
            ],
            "properties": {
              "dataset_name": {
                "type": "string"
              },
              "dataset_url": {
                "type": [
                  "string",
                  "null"
                ],
