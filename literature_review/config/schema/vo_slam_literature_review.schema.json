{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/vo_slam_literature_review.schema.json",
  "title": "Schema de Revisão Bibliográfica — VO/VSLAM Robusto em Condições Adversas",
  "description": "Schema híbrido: núcleo comum obrigatório + módulos temáticos opcionais. Projetado para revisão bibliográfica sobre robustez de Visual Odometry/Visual SLAM, incluindo métodos clássicos, deep learning, corrupções, fumaça/névoa, datasets, métricas e cenários florestais/UAV.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "paper",
    "classification",
    "evidence",
    "modules"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "paper": {
      "$ref": "#/$defs/paperCore"
    },
    "classification": {
      "$ref": "#/$defs/classification"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceItem"
      },
      "default": []
    },
    "modules": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "fundamentals_taxonomy": {
          "$ref": "#/$defs/fundamentalsTaxonomy"
        },
        "classical_geometric": {
          "$ref": "#/$defs/classicalGeometric"
        },
        "deep_vo_slam": {
          "$ref": "#/$defs/deepVOSLAM"
        },
        "robustness_corruptions": {
          "$ref": "#/$defs/robustnessCorruptions"
        },
        "atmospheric_optical": {
          "$ref": "#/$defs/atmosphericOptical"
        },
        "datasets_benchmarks": {
          "$ref": "#/$defs/datasetsBenchmarks"
        },
        "metrics_protocol": {
          "$ref": "#/$defs/metricsProtocol"
        },
        "forest_uav_amazon": {
          "$ref": "#/$defs/forestUAVAmazon"
        }
      }
    },
    "project_implications": {
      "$ref": "#/$defs/projectImplications"
    }
  },
  "$defs": {
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "evidenceRefArray": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^E[0-9]{3,}$"
      },
      "uniqueItems": true,
      "default": []
    },
    "paperCore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paper_id",
        "title",
        "authors",
        "year",
        "publication_type",
        "research_problem",
        "main_contribution",
        "main_results",
        "method_family",
        "sensor_modalities",
        "environment",
        "datasets",
        "evaluation_metrics",
        "limitations_authors",
        "limitations_reviewer",
        "code_available",
        "dataset_available"
      ],
      "properties": {
        "paper_id": {
          "type": "string",
          "pattern": "^P[0-9]{4,}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "year": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1900,
          "maximum": 2100
        },
        "venue": {
          "$ref": "#/$defs/nullableString"
        },
        "doi": {
          "$ref": "#/$defs/nullableString"
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "publication_type": {
          "type": "string",
          "enum": [
            "journal",
            "conference",
            "workshop",
            "preprint",
            "thesis",
            "dataset_paper",
            "survey",
            "book_chapter",
            "other",
            "NR"
          ]
        },
        "research_problem": {
          "$ref": "#/$defs/nullableString"
        },
        "research_question": {
          "$ref": "#/$defs/nullableString"
        },
        "method_name": {
          "$ref": "#/$defs/nullableString"
        },
        "method_family": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "feature_based",
              "direct",
              "semi_direct",
              "hybrid",
              "deep_learning",
              "geometry_learning_hybrid",
              "foundation_model",
              "image_restoration",
              "dataset",
              "benchmark",
              "survey",
              "other",
              "NR"
            ]
          },
          "uniqueItems": true
        },
        "sensor_modalities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "monocular_rgb",
              "stereo_rgb",
              "rgbd",
              "rgb_imu",
              "stereo_imu",
              "lidar",
              "thermal",
              "event_camera",
              "multimodal",
              "other",
              "NR"
            ]
          },
          "uniqueItems": true
        },
        "environment": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "indoor",
              "urban_outdoor",
              "road",
              "forest",
              "tropical_forest",
              "underground",
              "aerial",
              "wildfire",
              "aquatic",
              "synthetic",
              "mixed",
              "other",
              "NR"
            ]
          },
          "uniqueItems": true
        },
        "platform": {
          "$ref": "#/$defs/stringArray"
        },
        "datasets": {
          "$ref": "#/$defs/stringArray"
        },
        "evaluation_metrics": {
          "$ref": "#/$defs/stringArray"
        },
        "main_contribution": {
          "$ref": "#/$defs/nullableString"
        },
        "main_results": {
          "$ref": "#/$defs/stringArray"
        },
        "limitations_authors": {
          "$ref": "#/$defs/stringArray"
        },
        "limitations_reviewer": {
          "$ref": "#/$defs/stringArray"
        },
        "code_available": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "unclear",
            "NR"
          ]
        },
        "code_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "dataset_available": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "unclear",
            "NR"
          ]
        },
        "dataset_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "notes": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "theme_primary",
        "themes_secondary",
        "review_function",
        "priority",
        "relevance_score",
        "relevance_to_project"
      ],
      "properties": {
        "theme_primary": {
          "type": "string",
          "enum": [
            "fundamentals_taxonomy",
            "classical_geometric",
            "deep_vo_slam",
            "robustness_corruptions",
            "atmospheric_optical",
            "datasets_benchmarks",
            "metrics_protocol",
            "forest_uav_amazon",
            "other"
          ]
        },
        "themes_secondary": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "fundamentals_taxonomy",
              "classical_geometric",
              "deep_vo_slam",
              "robustness_corruptions",
              "atmospheric_optical",
              "datasets_benchmarks",
              "metrics_protocol",
              "forest_uav_amazon",
              "other"
            ]
          },
          "uniqueItems": true
        },
        "review_function": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "FOUNDATION",
              "METHOD_BASELINE",
              "METHOD_CANDIDATE",
              "ROBUSTNESS_EVIDENCE",
              "DEGRADATION_MODEL",
              "DATASET_CANDIDATE",
              "METRICS_METHOD",
              "AMAZON_CONTEXT",
              "RELATED_ONLY"
            ]
          },
          "uniqueItems": true
        },
        "priority": {
          "type": "string",
          "enum": [
            "ESSENTIAL",
            "IMPORTANT",
            "COMPLEMENTARY"
          ]
        },
        "relevance_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "relevance_to_project": {
          "type": "string"
        }
      }
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "claim_type",
        "claim",
        "quote_or_paraphrase",
        "location",
        "support_level"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "^E[0-9]{3,}$"
        },
        "claim_type": {
          "type": "string",
          "enum": [
            "method",
            "result",
            "dataset",
            "metric",
            "limitation",
            "assumption",
            "comparison",
            "other"
          ]
        },
        "claim": {
          "type": "string"
        },
        "quote_or_paraphrase": {
          "type": "string"
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "page": {
              "type": [
                "integer",
                "string",
                "null"
              ]
            },
            "section": {
              "$ref": "#/$defs/nullableString"
            },
            "table": {
              "$ref": "#/$defs/nullableString"
            },
            "figure": {
              "$ref": "#/$defs/nullableString"
            },
            "paragraph": {
              "$ref": "#/$defs/nullableString"
            }
          }
        },
        "support_level": {
          "type": "string",
          "enum": [
            "direct",
            "indirect",
            "reviewer_inference"
          ]
        },
        "notes": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "fundamentalsTaxonomy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task_type": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "VO",
              "SLAM",
              "VIO",
              "VISUAL_INERTIAL_SLAM",
              "LOCALIZATION",
              "MAPPING",
              "OTHER",
              "NR"
            ]
          },
          "uniqueItems": true
        },
        "estimation_scope": {
          "$ref": "#/$defs/stringArray"
        },
        "visual_input": {
          "$ref": "#/$defs/stringArray"
        },
        "frontend_type": {
          "$ref": "#/$defs/stringArray"
        },
        "backend_type": {
          "$ref": "#/$defs/stringArray"
        },
        "feature_or_representation": {
          "$ref": "#/$defs/nullableString"
        },
        "geometry_components": {
          "$ref": "#/$defs/stringArray"
        },
        "loop_closure_used": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "NR"
          ]
        },
        "relocalization_used": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "NR"
          ]
        },
        "scale_handling": {
          "$ref": "#/$defs/nullableString"
        },
        "core_assumptions": {
          "$ref": "#/$defs/stringArray"
        },
        "reported_failure_modes": {
          "$ref": "#/$defs/stringArray"
        },
        "taxonomy_contribution": {
          "$ref": "#/$defs/nullableString"
        },
        "project_connection": {
          "$ref": "#/$defs/nullableString"
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidenceRefArray"
        }
      }
    },
    "classicalGeometric": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "classical_paradigm": {
          "type": "string",
          "enum": [
            "feature_based",
            "direct",
            "semi_direct",
            "hybrid",
            "other",
            "NR"
          ]
        },
        "detector": {
          "$ref": "#/$defs/nullableString"
        },
        "descriptor": {
          "$ref": "#/$defs/nullableString"
        },
        "feature_matching_method": {
          "$ref": "#/$defs/nullableString"
        },
        "photometric_model": {
          "$ref": "#/$defs/nullableString"
        },
        "motion_estimation": {
          "$ref": "#/$defs/stringArray"
        },
        "outlier_rejection": {
          "$ref": "#/$defs/stringArray"
        },
        "keyframe_strategy": {
          "$ref": "#/$defs/nullableString"
        },
        "tracking_failure_definition": {
          "$ref": "#/$defs/nullableString"
        },
        "conditions_tested": {
          "$ref": "#/$defs/stringArray"
        },
        "degradation_effect_on_frontend": {
          "$ref": "#/$defs/nullableString"
        },
        "degradation_effect_on_pose": {
          "$ref": "#/$defs/nullableString"
        },
        "failure_chain": {
          "$ref": "#/$defs/nullableString"
        },
        "recovery_mechanism": {
          "$ref": "#/$defs/nullableString"
        },
        "advantages_reported": {
          "$ref": "#/$defs/stringArray"
        },
        "limitations_reported": {
          "$ref": "#/$defs/stringArray"
        },
        "relevance_for_ORB_DSO_baseline": {
          "$ref": "#/$defs/nullableString"
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidenceRefArray"
        }
      }
    },
    "deepVOSLAM": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "learning_role": {
          "$ref": "#/$defs/stringArray"
        },
        "architecture_family": {
          "$ref": "#/$defs/stringArray"
        },
        "geometric_constraints_used": {
          "$ref": "#/$defs/stringArray"
        },
        "differentiable_optimization": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "NR"
          ]
        },
        "training_type": {
          "type": "string",
          "enum": [
            "supervised",
            "self_supervised",
            "unsupervised",
            "mixed",
            "NR"
          ]
        },
        "training_datasets": {
          "$ref": "#/$defs/stringArray"
        },
        "training_domain": {
          "type": "string",
          "enum": [
            "synthetic",
            "real",
            "mixed",
            "NR"
          ]
        },
        "test_datasets": {
          "$ref": "#/$defs/stringArray"
        },
        "training_test_domain_gap": {
          "$ref": "#/$defs/nullableString"
        },
        "generalization_experiment": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "NR"
          ]
        },
        "generalization_details": {
          "$ref": "#/$defs/nullableString"
        },
        "adaptation_at_test_time": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "NR"
          ]
        },
        "adaptation_details": {
          "$ref": "#/$defs/nullableString"
        },
        "uncertainty_modeling": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "NR"
          ]
        },
        "uncertainty_details": {
          "$ref": "#/$defs/nullableString"
        },
        "temporal_modeling": {
          "$ref": "#/$defs/nullableString"
        },
        "pretrained_model_dependency": {
          "$ref": "#/$defs/nullableString"
        },
        "compute_requirements": {
          "$ref": "#/$defs/nullableString"
        },
        "failure_modes": {
          "$ref": "#/$defs/stringArray"
        },
        "comparison_with_classical_methods": {
          "$ref": "#/$defs/nullableString"
        },
        "relevance_to_TartanVO_DROID_DPVO": {
          "$ref": "#/$defs/nullableString"
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidenceRefArray"
        }
      }
    },
    "robustnessCorruptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "robustness_definition": {
          "$ref": "#/$defs/nullableString"
        },
        "baseline_condition": {
          "$ref": "#/$defs/nullableString"
        },
        "corruptions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "corruption_name",
              "corruption_family",
              "real_or_synthetic"
            ],
            "properties": {
              "corruption_name": {
                "type": "string"
              },
              "corruption_family": {
                "type": "string",
                "enum": [
                  "photometric",
                  "atmospheric",
                  "lens_contamination",
                  "optical_occlusion",
                  "motion",
                  "sensor_failure",
                  "digital_corruption",
                  "weather",
                  "other"
                ]
              },
              "real_or_synthetic": {
                "type": "string",
                "enum": [
                  "real",
                  "synthetic",
                  "both",
                  "NR"
                ]
              },
              "generation_method": {
                "$ref": "#/$defs/nullableString"
              },
              "severity_levels": {
                "$ref": "#/$defs/stringArray"
              },
              "spatial_characteristic": {
                "type": "string",
                "enum": [
                  "global",
                  "local",
                  "mixed",
                  "NR"
                ]
              },
              "temporal_characteristic": {
                "type": "string",
                "enum": [
                  "static",
                  "dynamic",
                  "time_varying",
                  "NR"
                ]
              },
              "physical_plausibility_discussed": {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  "NR"
                ]
              },
              "metrics_used": {
                "$ref": "#/$defs/stringArray"
              },
              "relative_degradation_reported": {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  "NR"
                ]
              },
              "tracking_failure_reported": {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  "NR"
                ]
              },
              "drift_reported": {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  "NR"
                ]
              },
              "failure_vs_drift_distinguished": {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  "NR"
                ]
              },
              "recovery_after_failure": {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  "NR"
                ]
              },
              "methods_most_affected": {
                "$ref": "#/$defs/stringArray"
              },
              "authors_explanation": {
                "$ref": "#/$defs/nullableString"
              },
              "reviewer_mechanistic_interpretation": {
                "$ref": "#/$defs/nullableString"
              },
              "relevance_to_QueensCAMP": {
                "$ref": "#/$defs/nullableString"
              },
              "evidence_refs": {
                "$ref": "#/$defs/evidenceRefArray"
              }
            }
          },
          "default": []
        }
      }
    },
    "atmosphericOptical": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "phenomena": {
          "$ref": "#/$defs/stringArray"
        },
        "real_or_simulated": {
          "type": "string",
          "enum": [
            "real",
            "simulated",
            "both",
            "NR"
          ]
